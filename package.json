{
  "name": "redact-pdf-mcp",
  "version": "0.2.1",
  "description": "Permanently redact PII from PDFs, scans and screenshots through your AI agent: the text is removed, not covered. EU & Swiss hosted, never used for AI training. MCP server for Redact PDF AI.",
  "mcpName": "io.github.dambuchs/redact-pdf-mcp",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "pdf",
    "redaction",
    "redact",
    "pii",
    "gdpr",
    "hipaa",
    "anonymization",
    "ocr",
    "claude",
    "ai-agent",
    "mcp-server",
    "anonymize",
    "de-identification",
    "document-redaction",
    "privacy",
    "claude-desktop",
    "cursor",
    "gdpr-compliance"
  ],
  "homepage": "https://www.redact-pdf.ai/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dambuchs/redact-pdf-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dambuchs/redact-pdf-mcp/issues"
  },
  "license": "MIT",
  "author": "Redact PDF AI",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "redact-pdf-mcp": "dist/stdio.js",
    "redact-pdf-mcp-http": "dist/http.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run test/demo.integration.test.ts",
    "test:all": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
